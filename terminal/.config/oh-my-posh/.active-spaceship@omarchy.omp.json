{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "transient_prompt": {
    "template": "❯ "
  },
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": false
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "{{ .UserName }} ",
          "foreground": "lightYellow",
          "type": "session",
          "style": "plain"
        },
        {
          "options": {
            "max_width": 80,
            "style": "powerlevel"
          },
          "template": "<lightWhite>in</> {{ .Path }}{{ if not .Writable }} {{ end }} ",
          "foreground": "cyan",
          "type": "path",
          "style": "plain",
          "index": 2
        },
        {
          "options": {
            "branch_icon": " <green><b> </b></>",
            "branch_template": "{{ if gt (len .Branch) 32 }}{{ trunc 12 .Branch }}…{{ trunc -12 .Branch }}{{ else }}{{ .Branch }}{{ end }}",
            "untracked_modes": {
              "*": "all"
            }
          },
          "template": "<lightWhite>on</> {{ .HEAD }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }}{{ if and .Upstream (ne (base .Upstream) .Ref) }}:{{ .Upstream }}{{ end }}{{ if and .Commit (regexMatch \"(?i)(^|[^a-z0-9])wip([^a-z0-9]|$)\" .Commit.Subject) }} wip{{ end }}{{ if gt .Behind 0 }} ⇣{{ .Behind }}{{ end }}{{ if gt .Ahead 0 }} ⇡{{ .Ahead }}{{ end }}{{ if gt .PushBehind 0 }} ⇠{{ .PushBehind }}{{ end }}{{ if gt .PushAhead 0 }} ⇢{{ .PushAhead }}{{ end }}{{ if .Working.Changed }} !{{ .Working.String }}{{ end }}{{ if .Staging.Changed }} +{{ .Staging.String }}{{ end }}{{ if .Merge }} merge{{ end }}{{ if .Rebase }} rebase{{ end }}{{ if .CherryPick }} cherry-pick{{ end }}{{ if .Revert }} revert{{ end }} ",
          "foreground": "green",
          "type": "git",
          "style": "plain",
          "exclude_folders": [
            "~"
          ],
          "index": 3
        }
      ],
      "index": 1
    },
    {
      "type": "prompt",
      "alignment": "right",
      "overflow": "hide",
      "segments": [
        {
          "alias": "FunctionalStatus",
          "template": "{{ if .Error }}✘ {{ .Code }}{{ if gt .Code 128 }} ({{ reason .Code }}){{ end }} {{ end }}",
          "foreground": "lightYellow",
          "type": "status",
          "style": "plain"
        },
        {
          "options": {
            "style": "round",
            "threshold": 3000
          },
          "alias": "FunctionalExecutionTime",
          "template": "took {{ .FormattedMs }} ",
          "foreground": "lightYellow",
          "type": "executiontime",
          "style": "plain"
        },
        {
          "alias": "FunctionalJobs",
          "template": "{{ if gt .Jobs 0 }}✦ {{ end }}",
          "foreground": "lightYellow",
          "type": "text",
          "style": "plain"
        },
        {
          "alias": "FunctionalDirenv",
          "template": "{{ if .Env.DIRENV_DIR }}direnv {{ end }}",
          "foreground": "lightYellow",
          "type": "text",
          "style": "plain"
        },
        {
          "options": {
            "cache_duration": "1m",
            "display_default": false,
            "display_mode": "context"
          },
          "alias": "FunctionalPython",
          "template": "{{ if .Venv }}{{ .Venv }} {{ else if and .Full (not .Error) }}py {{ .Full }} {{ end }}",
          "foreground": "lightYellow",
          "type": "python",
          "style": "plain",
          "timeout": 250
        },
        {
          "options": {
            "cache_duration": "1m",
            "display_mode": "context"
          },
          "alias": "FunctionalNode",
          "template": "{{ if and .Full (not .Error) }}node {{ .Full }} {{ end }}",
          "foreground": "lightYellow",
          "type": "node",
          "style": "plain",
          "timeout": 250
        },
        {
          "options": {
            "cache_duration": "1m",
            "display_mode": "context"
          },
          "alias": "FunctionalGo",
          "template": "{{ if and .Full (not .Error) }}go {{ .Full }} {{ end }}",
          "foreground": "lightYellow",
          "type": "go",
          "style": "plain",
          "timeout": 250
        },
        {
          "options": {
            "cache_duration": "1m",
            "display_mode": "context"
          },
          "alias": "FunctionalRust",
          "template": "{{ if and .Full (not .Error) }}rust {{ .Full }} {{ end }}",
          "foreground": "lightYellow",
          "type": "rust",
          "style": "plain",
          "timeout": 250
        },
        {
          "options": {
            "cache_duration": "1m",
            "display_mode": "context"
          },
          "alias": "FunctionalJava",
          "template": "{{ if and .Full (not .Error) }}java {{ .Full }} {{ end }}",
          "foreground": "lightYellow",
          "type": "java",
          "style": "plain",
          "timeout": 250
        },
        {
          "options": {
            "cache_duration": "1m",
            "display_mode": "context"
          },
          "alias": "FunctionalPhp",
          "template": "{{ if and .Full (not .Error) }}php {{ .Full }} {{ end }}",
          "foreground": "lightYellow",
          "type": "php",
          "style": "plain",
          "timeout": 250
        },
        {
          "options": {
            "cache_duration": "1m",
            "display_mode": "context"
          },
          "alias": "FunctionalRuby",
          "template": "{{ if and .Full (not .Error) }}ruby {{ .Full }} {{ end }}",
          "foreground": "lightYellow",
          "type": "ruby",
          "style": "plain",
          "timeout": 250
        },
        {
          "options": {
            "cache_duration": "1m",
            "display_mode": "context"
          },
          "alias": "FunctionalFlutter",
          "template": "{{ if and .Full (not .Error) }}flutter {{ .Full }} {{ end }}",
          "foreground": "lightYellow",
          "type": "flutter",
          "style": "plain",
          "timeout": 250
        },
        {
          "options": {
            "cache_duration": "1m",
            "display_mode": "context"
          },
          "alias": "FunctionalLua",
          "template": "{{ if and .Full (not .Error) }}lua {{ .Full }} {{ end }}",
          "foreground": "lightYellow",
          "type": "lua",
          "style": "plain",
          "timeout": 250
        },
        {
          "options": {
            "cache_duration": "1m",
            "display_mode": "context"
          },
          "alias": "FunctionalPerl",
          "template": "{{ if and .Full (not .Error) }}perl {{ .Full }} {{ end }}",
          "foreground": "lightYellow",
          "type": "perl",
          "style": "plain",
          "timeout": 250
        },
        {
          "options": {
            "cache_duration": "1m",
            "display_mode": "context"
          },
          "alias": "FunctionalHaskell",
          "template": "{{ if and .Full (not .Error) }}ghc {{ .Full }} {{ end }}",
          "foreground": "lightYellow",
          "type": "haskell",
          "style": "plain",
          "timeout": 250
        },
        {
          "alias": "FunctionalTerraform",
          "template": "{{ if ne .WorkspaceName \"default\" }}tf {{ .WorkspaceName }} {{ end }}",
          "foreground": "lightYellow",
          "type": "terraform",
          "style": "plain",
          "timeout": 250
        },
        {
          "alias": "FunctionalNixShell",
          "template": "nix {{ .Type }} ",
          "foreground": "lightYellow",
          "type": "nix-shell",
          "style": "plain"
        },
        {
          "options": {
            "time_format": "15:04:05"
          },
          "alias": "FunctionalTime",
          "template": "at {{ .CurrentDate | date .Format }}",
          "foreground": "lightYellow",
          "type": "time",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "❯",
          "foreground": "lightGreen",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "version": 4,
  "final_space": true,
  "var": {
    "omp_right_above_input": true
  }
}
