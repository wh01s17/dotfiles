#!/bin/bash

# omarchy:summary=Update Arch signing keys
# omarchy:hidden=true
#
# wh01s17: replaced in the frozen copy. Upstream ties this command to the
# Omarchy package repository or to a git checkout of OMARCHY_PATH, which
# here would be ~/dotfiles.

echo -e "\e[32m\nUpdate Arch signing keys\e[0m"
sudo pacman -Sy --noconfirm --needed archlinux-keyring >/dev/null
