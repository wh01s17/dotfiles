#!/bin/bash

# omarchy:summary=Show the frozen Omarchy version
# omarchy:hidden=true
#
# wh01s17: replaced in the frozen copy. Upstream ties this command to the
# Omarchy package repository or to a git checkout of OMARCHY_PATH, which
# here would be ~/dotfiles.

cat "${OMARCHY_PATH:-$HOME/.local/share/omarchy}/VERSION"
