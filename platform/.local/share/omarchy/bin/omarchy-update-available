#!/bin/bash

# omarchy:summary=Report available system updates
# omarchy:hidden=true
#
# wh01s17: replaced in the frozen copy. Upstream ties this command to the
# Omarchy package repository or to a git checkout of OMARCHY_PATH, which
# here would be ~/dotfiles.

count=$(checkupdates --nocolor 2>/dev/null | wc -l)
if command -v yay >/dev/null 2>&1; then
  count=$((count + $(yay -Qua 2>/dev/null | wc -l)))
fi
if ((count > 0)); then
  echo "$count actualizaciones de paquetes disponibles"
  exit 0
fi
echo "El sistema está al día"
exit 1
