{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "core.clock",
    "layout": {
      "left": [
        {
          "id": "core.menu"
        },
        {
          "id": "core.workspaces"
        }
      ],
      "center": [
        {
          "id": "core.indicators"
        },
        {
          "id": "core.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "core.keyboard-layout"
        },
        {
          "id": "core.weather"
        },
        {
          "id": "core.system-update"
        }
      ],
      "right": [
        {
          "id": "core.tray"
        },
        {
          "id": "core.agents"
        },
        {
          "id": "core.bluetooth"
        },
        {
          "id": "core.network"
        },
        {
          "id": "core.audio"
        },
        {
          "id": "core.monitor"
        },
        {
          "id": "core.power"
        }
      ]
    }
  },
  "plugins": []
}
