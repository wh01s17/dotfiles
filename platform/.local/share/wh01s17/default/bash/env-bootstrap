# Single source of truth for WH01S17_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/wh01s17.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-wh01s17          (Hyprland session via uwsm)
#   /usr/share/wh01s17/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/wh01s17.conf is written by wh01s17-dev-link and reset by
# wh01s17-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
# wh01s17: frozen copy installed with Stow; see platform/README.md.
: "${WH01S17_PATH:=$HOME/.local/share/wh01s17}"
export WH01S17_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/wh01s17-* via the wh01s17 package — prepending
# /usr/share/wh01s17/bin would just be noise.
if [ "$WH01S17_PATH" != /usr/share/wh01s17 ]; then
  case ":$PATH:" in
    *":${WH01S17_PATH%/}/bin:"*) ;;
    *) PATH="${WH01S17_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
