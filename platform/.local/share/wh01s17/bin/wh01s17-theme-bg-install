#!/bin/bash

# wh01s17:summary=Open the current theme's user background folder

CURRENT_THEME_NAME=$(cat "$HOME/.local/state/wh01s17/current/theme.name")
THEME_USER_BACKGROUNDS="$HOME/.config/wh01s17/backgrounds/$CURRENT_THEME_NAME"

mkdir -p "$THEME_USER_BACKGROUNDS"
nautilus "$THEME_USER_BACKGROUNDS"
