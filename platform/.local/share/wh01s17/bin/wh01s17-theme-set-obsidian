#!/bin/bash

# wh01s17:summary=Sync wh01s17 theme to all Obsidian vaults
# wh01s17:hidden=true

CURRENT_THEME_DIR="$HOME/.local/state/wh01s17/current/theme"

[[ -f $CURRENT_THEME_DIR/obsidian.css ]] || exit 0

jq -r '.vaults | values[].path' ~/.config/obsidian/obsidian.json 2>/dev/null | while read -r vault_path; do
  [[ -d $vault_path/.obsidian ]] || continue

  theme_dir="$vault_path/.obsidian/themes/wh01s17"
  mkdir -p "$theme_dir"

  [[ -f $theme_dir/manifest.json ]] || cat >"$theme_dir/manifest.json" <<'EOF'
{
  "name": "wh01s17",
  "version": "1.0.0",
  "minAppVersion": "0.16.0",
  "description": "Automatically syncs with your current wh01s17 system theme colors and fonts",
  "author": "wh01s17",
  "authorUrl": "https://github.com/wh01s17"
}
EOF

  cp "$CURRENT_THEME_DIR/obsidian.css" "$theme_dir/theme.css"
done
