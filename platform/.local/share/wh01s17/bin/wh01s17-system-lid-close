#!/bin/bash

# wh01s17:summary=Reconcile displays and pause idle when the laptop lid closes
# wh01s17:group=system
# wh01s17:hidden=true

marker="$HOME/.local/state/wh01s17/lid-paused-idle"
if [[ ! -f $HOME/.local/state/wh01s17/indicators/stay-awake ]]; then
  mkdir -p "${marker%/*}"
  touch "$marker"
  wh01s17-shell -q idle disable
fi
wh01s17-hyprland-monitor-clamshell
