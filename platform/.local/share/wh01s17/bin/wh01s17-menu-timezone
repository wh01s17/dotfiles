#!/bin/bash

# wh01s17:summary=Select and set the system timezone
# wh01s17:group=menu
# wh01s17:name=timezone

set -e

timezone=$(timedatectl list-timezones | wh01s17-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
wh01s17-shell -q core.clock refresh
wh01s17-notification-send "Timezone is now set to $timezone"
