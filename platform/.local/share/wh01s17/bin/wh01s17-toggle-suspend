#!/bin/bash

# wh01s17:summary=Toggle suspend availability in the system menu

wh01s17-toggle suspend-off || exit 1

if wh01s17-toggle-enabled suspend-off; then
  wh01s17-notification-send -g 󰒲 "Suspend removed from system menu"
else
  wh01s17-notification-send -g 󰒲 "Suspend now available in system menu"
fi
