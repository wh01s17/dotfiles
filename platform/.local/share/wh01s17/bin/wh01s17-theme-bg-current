#!/bin/bash

# wh01s17:summary=Show current background
# wh01s17:examples=wh01s17 theme bg current

BACKGROUND_PATH=$(readlink -f "$HOME/.local/state/wh01s17/current/background" 2>/dev/null)

if [[ -n $BACKGROUND_PATH ]]; then
  basename -- "$BACKGROUND_PATH" | perl -pe 's/\.[^.]+$//; s/^\d+-//; s/-/ /g; s/\b(\w)/\U$1/g'
else
  echo "Unknown"
fi
