#!/bin/bash

# wh01s17:summary=Install a packaged app, surfacing the install in a floating terminal
# wh01s17:args=<display-name> <packages>
# wh01s17:examples=wh01s17 install app 'LM Studio' lmstudio-bin

name="${1-}"
packages="${2-}"

if [[ -z $name || -z $packages ]]; then
  echo "Usage: wh01s17-install-app <display-name> <packages>" >&2
  exit 1
fi

printf -v install_message '%q' "Installing ${name}..."

# The list has to reach wh01s17-pkg-add as several words, so each word is quoted
# rather than the whole string; -d '' reads past newlines and always ends at EOF.
read -r -d '' -a package_list <<<"$packages" || true
printf -v packages_arg '%q ' "${package_list[@]}"
packages_arg="${packages_arg% }"

exec wh01s17-launch-floating-terminal-with-presentation \
  "echo ${install_message}; wh01s17-pkg-add ${packages_arg}"
