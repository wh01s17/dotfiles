#!/bin/bash

# wh01s17:summary=Show the current wh01s17 dev-link state
# wh01s17:group=dev

set -euo pipefail

default_target="/usr/share/wh01s17"
sudoers_file="/etc/sudoers.d/wh01s17-dev-path"
configured="$default_target"
conf_present=0
linked=0

if [[ -f /etc/wh01s17.conf ]]; then
  conf_present=1
  configured=$(
    WH01S17_PATH=
    # shellcheck disable=SC1091
    . /etc/wh01s17.conf
    printf '%s' "${WH01S17_PATH:-<empty>}"
  )
  if [[ $configured != "$default_target" ]]; then
    linked=1
  fi
fi

# /etc/sudoers.d is root-only, so report what sudo resolves rather than reading
# the drop-in — and say so plainly instead of guessing when there is no cached
# credential to ask with. A missing entry here is what makes `sudo wh01s17-*`
# run the packaged copy of a command the checkout has changed.
sudo_bin_dir() {
  local resolved

  if ! sudo -n true 2>/dev/null; then
    echo "unknown (needs sudo)"
    return
  fi

  resolved=$(sudo -n bash -c 'type -P wh01s17-dev-status' 2>/dev/null) || {
    echo "not on sudo's PATH"
    return
  }

  dirname "$resolved"
}

if (( linked )); then
  echo "dev-link: configured"
  echo "  /etc/wh01s17.conf -> WH01S17_PATH=$configured"
  echo "  sudo resolves wh01s17-* from: $(sudo_bin_dir)"
  echo "  status: reboot required before all session layers use this checkout"
else
  echo "dev-link: inactive"
  if (( conf_present )); then
    echo "  /etc/wh01s17.conf -> WH01S17_PATH=$configured (default guard)"
  fi
fi

echo "  current shell:       WH01S17_PATH=${WH01S17_PATH:-<unset>}"

if [[ ${WH01S17_PATH:-$default_target} != "$configured" ]]; then
  echo
  echo "Note: the running session does not match /etc/wh01s17.conf. Reboot to settle it."
fi
