#!/bin/bash

# wh01s17:summary=Install a Nerd Font package and switch the system to it
# wh01s17:args=<display-name> <package> <family>
# wh01s17:examples=wh01s17 install font 'Cascadia Mono' ttf-cascadia-mono-nerd 'CaskaydiaMono Nerd Font'

name="${1-}"
package="${2-}"
family="${3-}"

if [[ -z $name || -z $package || -z $family ]]; then
  echo "Usage: wh01s17-install-font <display-name> <package> <family>" >&2
  exit 1
fi

printf -v install_message '%q' "Installing ${name}..."
printf -v package_arg '%q' "$package"
printf -v family_arg '%q' "$family"

exec wh01s17-launch-floating-terminal-with-presentation \
  "echo ${install_message}; wh01s17-pkg-add ${package_arg} && sleep 2 && wh01s17-font-set ${family_arg}"
