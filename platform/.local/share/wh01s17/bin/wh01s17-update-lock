#!/bin/bash

# wh01s17:summary=Run a command while holding the wh01s17 update lock
# wh01s17:args=<held|run> [command] [args...]
# wh01s17:hidden=true

set -e

lock_dir="${XDG_RUNTIME_DIR:-/tmp}"
lock_path="$lock_dir/wh01s17-update.lock"

lock_is_held() {
  local lock_fd_path=""

  [[ -n ${WH01S17_UPDATE_LOCK_FD:-} && -e /proc/$$/fd/$WH01S17_UPDATE_LOCK_FD ]] || return 1

  lock_fd_path=$(readlink -f "/proc/$$/fd/$WH01S17_UPDATE_LOCK_FD" 2>/dev/null || true)
  [[ $lock_fd_path == "$(readlink -m "$lock_path")" ]] &&
    flock -n "$WH01S17_UPDATE_LOCK_FD"
}

case "${1:-}" in
  held)
    lock_is_held
    ;;
  run)
    shift
    if (( $# == 0 )); then
      echo "Usage: wh01s17-update-lock run <command> [args...]" >&2
      exit 2
    fi

    mkdir -p "$lock_dir" 2>/dev/null || true
    exec {WH01S17_UPDATE_LOCK_FD}>"$lock_path"
    if ! flock -n "$WH01S17_UPDATE_LOCK_FD"; then
      echo "An wh01s17 update is already running."
      exit 1
    fi

    export WH01S17_UPDATE_LOCK_FD
    exec "$@"
    ;;
  *)
    echo "Usage: wh01s17-update-lock <held|run> [command] [args...]" >&2
    exit 2
    ;;
esac
