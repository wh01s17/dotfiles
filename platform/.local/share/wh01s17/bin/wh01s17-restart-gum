#!/bin/bash

# wh01s17:summary=Export the current theme's gum styling into the environment
# wh01s17:hidden=true

# Meant to be sourced. gum_env.lua is fed into the compositor environment via
# hl.env at login, but that environment is captured once and is not refreshed on
# a theme switch, so anything launched from the session would otherwise inherit
# the login-time theme's gum colors. Export the current values instead.
_wh01s17_gum_env="$HOME/.local/state/wh01s17/current/theme/gum_env.lua"

if [[ -f $_wh01s17_gum_env ]]; then
  while IFS=$'\t' read -r _wh01s17_gum_key _wh01s17_gum_value; do
    [[ -n $_wh01s17_gum_key && -n $_wh01s17_gum_value ]] && export "$_wh01s17_gum_key=$_wh01s17_gum_value"
  done < <(awk -F'"' '/hl\.env\("[A-Z0-9_]+", "[^"]+"\)/ { print $2 "\t" $4 }' "$_wh01s17_gum_env")
fi

unset _wh01s17_gum_env _wh01s17_gum_key _wh01s17_gum_value
