#!/bin/bash

# wh01s17:summary=Manage persistent state files for wh01s17 toggles and settings.
# wh01s17:args=<set|clear> <state-name-or-pattern>
# wh01s17:hidden=true

STATE_DIR="$HOME/.local/state/wh01s17"
mkdir -p "$STATE_DIR"

COMMAND="$1"
STATE_NAME="$2"

if [[ -z $COMMAND ]]; then
  echo "Usage: wh01s17-state <set|clear> <state-name-or-pattern>"
  exit 1
fi

if [[ -z $STATE_NAME ]]; then
  echo "Usage: wh01s17-state $COMMAND <state-name>"
  exit 1
fi

case "$COMMAND" in
set) touch "$STATE_DIR/$STATE_NAME" ;;
clear) find "$STATE_DIR" -maxdepth 1 -type f -name "$STATE_NAME" -delete ;;
esac
