#!/bin/bash

# wh01s17:summary=Install Steam and graphics drivers selected for this system
# wh01s17:requires-sudo=true

set -e

echo "Installing Steam..."
wh01s17-pkg-add steam
wh01s17-install-gaming-gpu-lib32

echo ""
echo "Steam will start automatically now. This might take a while..."

setsid uwsm-app -- gtk-launch steam >/dev/null 2>&1 &
