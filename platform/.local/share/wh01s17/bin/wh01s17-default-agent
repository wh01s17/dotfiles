#!/bin/bash

# wh01s17:summary=Set and launch the default coding agent
# wh01s17:args=[pi|omp|opencode|claude|codex|grok|gemini|openclaw|hermes|copilot|crush|cursor-agent|muse]
# wh01s17:examples=wh01s17 default agent | wh01s17 default agent codex | wh01s17 default agent claude

installing=false
if [[ ${1:-} == "--install" ]]; then
  installing=true
  shift
fi

agent_file="$HOME/.config/wh01s17/defaults/agent"

if (($# == 0)); then
  if [[ -f $agent_file ]]; then
    read -r agent <"$agent_file"
  fi

  # Silent when unset rather than defaulting: wh01s17 picks no agent for you, so
  # the menu leaves every entry unchecked until one is chosen.
  [[ -n ${agent:-} ]] && echo "$agent"
  exit 0
fi

case "$1" in
pi) agent="pi"; name="Pi" ;;
omp | oh-my-pi) agent="omp"; name="Oh My Pi"; agent_package="github:can1357/oh-my-pi" ;;
opencode | open-code) agent="opencode"; name="OpenCode" ;;
claude | claude-code) agent="claude"; name="Claude Code" ;;
codex) agent="codex"; name="Codex" ;;
crush) agent="crush"; name="Crush" ;;
grok) agent="grok"; name="Grok"; agent_package="npm:@xai-official/grok" ;;
gemini | gemini-cli) agent="gemini"; name="Gemini" ;;
openclaw) agent="openclaw"; name="OpenClaw"; agent_installer="wh01s17-install-openclaw-cli" ;;
hermes) agent="hermes"; name="Hermes"; agent_installer="wh01s17-install-hermes-cli" ;;
copilot | github-copilot) agent="copilot"; name="GitHub Copilot" ;;
muse | muse-code | musecode)
  agent="muse"; name="Muse Code"
  # Meta's launcher verifies and updates the native binary for this platform.
  agent_package="http:muse[url=https://api.meta.ai/muse-launcher.sh,bin=muse,version_list_url=https://api.meta.ai/muse-code/channels/muse-stable,version_json_path=.version]"
  ;;
cursor | cursor-agent) agent="cursor-agent"; name="Cursor CLI" ;;
*)
  echo "Usage: wh01s17-default-agent <pi|omp|opencode|claude|codex|grok|gemini|openclaw|hermes|copilot|crush|cursor-agent|muse>"
  exit 1
  ;;
esac

agent_package=${agent_package:-$agent}

# Hermes reaches mise through its own installer rather than straight from
# here: it needs its interpreter pinned, and a bare `mise use` has nowhere to
# say so. See wh01s17-install-hermes-cli. OpenClaw comes from its pacman
# package the same way; see wh01s17-install-openclaw-cli.
if [[ -n ${agent_installer:-} ]]; then
  # Not wh01s17-cmd-present: the stub is on PATH from first boot and says
  # nothing about whether Hermes is installed behind it. Treating a cold stub
  # as installed skips the floating terminal and runs the minute-long install
  # inside the menu action instead.
  agent_present() { "$agent_installer" --check; }
  agent_install() { "$agent_installer" --now; }
else
  # Anything at the wrapper's path other than the wrapper is the user's own
  # install, such as the symlink Cursor's installer leaves. A mise copy would
  # only shadow it, since the mise shims precede ~/.local/bin on PATH.
  user_install() {
    [[ -x $HOME/.local/bin/$agent ]] &&
      { [[ -L $HOME/.local/bin/$agent ]] || ! grep -q '^mise use -g' "$HOME/.local/bin/$agent"; }
  }
  agent_present() { user_install || mise where "$agent_package" &>/dev/null; }
  agent_install() { user_install || mise use -g "$agent_package"; }
fi

if [[ $installing == "false" ]] && ! agent_present; then
  exec wh01s17-launch-floating-terminal-with-presentation wh01s17-default-agent --install "$agent"
fi

if ! agent_install; then
  if [[ $installing == "true" ]]; then
    echo "Could not install $name with mise" >&2
  else
    echo "Could not set $name as the default coding agent" >&2
  fi
  exit 1
fi

mkdir -p "$(dirname "$agent_file")" || exit 1
printf '%s\n' "$agent" >"$agent_file" || exit 1

if [[ $installing == "true" ]]; then
  printf '\033[2J\033[3J\033[H'
  exec wh01s17-agent --inline
else
  exec wh01s17-agent
fi
