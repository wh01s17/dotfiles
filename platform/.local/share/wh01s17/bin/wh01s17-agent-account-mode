#!/bin/bash

# wh01s17:summary=Switch Claude, Codex, or Grok accounts automatically near a limit, or only notify
# wh01s17:args=[claude|codex|grok] [manual|auto] [threshold]
# wh01s17:examples=wh01s17 agent account mode auto | wh01s17 agent account mode auto 90 | wh01s17 agent account mode codex manual

set -uo pipefail

# The provider can be left out when it's your default agent:
# `wh01s17 agent account use work`.
if [[ ${1:-} != "claude" && ${1:-} != "codex" && ${1:-} != "grok" ]]; then
  default=$(wh01s17-default-agent)
  [[ $default == "claude" || $default == "codex" || $default == "grok" ]] && set -- "$default" "$@"
fi

if [[ ${1:-} != "claude" && ${1:-} != "codex" && ${1:-} != "grok" ]]; then
  echo "Usage: wh01s17-agent-account-mode [claude|codex|grok] [manual|auto] [threshold]" >&2
  exit 1
fi

if [[ -n ${2:-} ]]; then
  wh01s17-agent-account-state mode "$@" || exit 1
fi

wh01s17-agent-account-state registry "$1" | jq -r '
  if .switch == "auto" then
    "\(.name) switches new sessions to the account with the most headroom at \(.threshold)%."
  else
    "\(.name) notifies at \(.threshold)% and switches when you say so."
  end'
