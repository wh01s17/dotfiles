#!/bin/bash

# wh01s17:summary=Remove Heroic Games Launcher and its game libraries, configs, and caches.
# wh01s17:requires-sudo=true

set -e

wh01s17-pkg-drop heroic-games-launcher-bin

rm -rf \
  "$HOME/.config/heroic" \
  "$HOME/.local/share/heroic" \
  "$HOME/.cache/heroic" \
  "$HOME/Games/Heroic"

echo ""
echo "Heroic and its data have been removed."
