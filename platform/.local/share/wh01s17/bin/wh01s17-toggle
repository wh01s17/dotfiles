#!/bin/bash

# wh01s17:summary=Toggle wh01s17 features between enabled and disabled
# wh01s17:args=<flag-name> [toggle|on|off]

if (($# < 1)); then
  echo "Usage: wh01s17-toggle <flag-name> [toggle|on|off]" >&2
  exit 1
fi

FLAG_NAME="$1"
ACTION="${2:-toggle}"
FLAG="$HOME/.local/state/wh01s17/toggles/$FLAG_NAME"

enable() {
  mkdir -p "$(dirname "$FLAG")" || return 1
  [[ ! -d $FLAG ]] || { echo "State file is a directory: $FLAG" >&2; return 1; }
  touch "$FLAG"
}

disable() {
  rm -f "$FLAG"
}

case "$ACTION" in
  toggle|"")
    if [[ -f $FLAG ]]; then
      disable
    else
      enable
    fi
    ;;
  on)
    enable
    ;;
  off)
    disable
    ;;
  *)
    echo "Usage: wh01s17-toggle <flag-name> [toggle|on|off]" >&2
    exit 1
    ;;
esac
