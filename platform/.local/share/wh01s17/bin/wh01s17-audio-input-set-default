#!/bin/bash

# wh01s17:summary=Set the default audio input and move active streams
# wh01s17:args=<node-id> <source-name>
# wh01s17:examples=wh01s17 audio input set default 43 alsa_input.pci-0000_00_1f.3.analog-stereo

node_id=${1:-}
source_name=${2:-}

if [[ -z $node_id || -z $source_name ]]; then
  echo "Usage: wh01s17-audio-input-set-default <node-id> <source-name>" >&2
  exit 1
fi

wpctl set-default "$node_id" 2>/dev/null || true
pactl set-default-source "$source_name" 2>/dev/null || exit 1

# Move only real application captures. A virtual microphone built from loopback
# or filter-chain streams (the Mezcla routing in 20-mezcla.conf) captures through
# source outputs too, but carries no application.name; moving those would point
# the mix at the newly selected source -- itself, when that is the virtual mic.
# pactl translates its headers; parse them in the C locale.
LC_ALL=C pactl list source-outputs 2>/dev/null | awk '
  /^Source Output #/ {id = substr($3, 2)}
  /application\.name = / {print id}' | while read -r output; do
  [[ -n $output ]] && pactl move-source-output "$output" "$source_name" 2>/dev/null || true
done
