#!/bin/bash

# wh01s17:summary=Show idle, screensaver, and lock diagnostics
# wh01s17:group=debug
# wh01s17:args=[log-lines]
# wh01s17:examples=wh01s17 debug idle | wh01s17-debug-idle 400

lines=${1:-200}
if [[ ! $lines =~ ^[0-9]+$ ]]; then
  lines=200
fi

section() {
  printf '\n== %s ==\n' "$1"
}

section "Time"
date -Is

section "Idle IPC status"
wh01s17-shell idle status 2>&1 | jq . 2>/dev/null || wh01s17-shell idle status 2>&1 || true

section "Quickshell instances"
quickshell list -p "$WH01S17_PATH/shell" --any-display 2>&1 || true

section "Recent idle logs"
quickshell --no-color log -p "$WH01S17_PATH/shell" --any-display --tail "$lines" --log-times -r 'quickshell.wayland.idle_notify=true' 2>&1 \
  | grep -Ei 'wh01s17 idle|idle_notify|screensaver|lock|error|warn|failed' || true

section "Persisted shell log"
journalctl -t wh01s17-shell -n "$lines" --no-pager --quiet 2>/dev/null || true

section "Relevant processes"
ps -eo pid=,args= \
  | grep -E 'quickshell -n -p|wh01s17-system-sleep-monitor|systemd-inhibit.*Lock screen before suspend|org\.wh01s17\.screensaver|wh01s17-screensaver|(^|/| )ttfx( |$)' \
  | grep -v grep || true

section "Sleep lock service"
systemctl --user status wh01s17-sleep-lock.service --no-pager 2>/dev/null || true

section "Hyprland screensaver clients"
hyprctl clients -j 2>/dev/null \
  | jq -r '.[] | select(.class == "org.wh01s17.screensaver" or .initialClass == "org.wh01s17.screensaver") | [.pid,.class,.initialClass,.title,.focusHistoryID] | @tsv' || true

section "Idle inhibitors"
hyprctl clients -j 2>/dev/null \
  | jq -r '.[] | select(.inhibitingIdle == true or ((.tags // []) | index("noidle"))) | [.pid,.class,.title,((.tags // []) | join(",")),.inhibitingIdle] | @tsv' || true

section "Screensaver detector"
if hyprctl clients -j 2>/dev/null | jq -e '.[] | select(.class == "org.wh01s17.screensaver" or .initialClass == "org.wh01s17.screensaver")' >/dev/null; then
  echo "running-window"
elif pgrep -f '[o]rg.wh01s17.screensaver' >/dev/null; then
  echo "running-process"
elif wh01s17-toggle-enabled screensaver-off; then
  echo "disabled"
else
  echo "stopped"
fi

section "Lock detector"
wh01s17-shell lock status 2>&1 | jq . 2>/dev/null || wh01s17-shell lock status 2>&1 || true
