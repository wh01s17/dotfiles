#!/bin/bash

# wh01s17:summary=Overwrite the user config for the Limine bootloader and rebuild it.
# wh01s17:requires-sudo=true

legacy_uki="/boot/EFI/Linux/$(cat /etc/machine-id)_linux.efi"

if sudo test -f /boot/EFI/Linux/wh01s17_linux.efi && sudo test -f "$legacy_uki"; then
  echo "Cleanup extra UKI"
  sudo rm -f "$legacy_uki"
fi
echo "Resetting limine config"

sudo mv /boot/limine.conf /boot/limine.conf.bak

sudo cp "$WH01S17_PATH/default/limine/limine.conf" /boot/limine.conf

sudo limine-update
sudo limine-snapper-sync
