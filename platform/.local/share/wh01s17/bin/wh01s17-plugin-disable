#!/bin/bash

# wh01s17:summary=Disable a shell plugin
# wh01s17:group=plugin
# wh01s17:args=<id>

set -euo pipefail

fail() {
  echo "wh01s17-plugin-disable: $*" >&2
  exit 1
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: wh01s17 plugin disable <id>"
  exit 0
fi

id="${1:-}"
[[ -n $id ]] || fail "plugin id is required"

result=$(wh01s17-shell shell setPluginEnabled "$id" false)
[[ $result == "ok" ]] ||
  fail "plugin '$id' is not known; run: wh01s17-shell shell rescanPlugins"

echo "Disabled $id"
