#!/bin/bash

# wh01s17:summary=Launch a TUI or focus an existing terminal window for it
# wh01s17:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.wh01s17.$(basename "$1")"
fi

LAUNCH_COMMAND="wh01s17-launch-tui $@"

exec wh01s17-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
