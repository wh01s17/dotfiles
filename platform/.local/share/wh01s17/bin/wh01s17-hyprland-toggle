#!/bin/bash

# wh01s17:summary=Toggle permanent Hyprland flags by copying them into a directory that's sourced entirely.
# wh01s17:args=<flag-name> [on|off|toggle]

usage() {
  echo "Usage: wh01s17-hyprland-toggle <flag-name> [on|off|toggle]" >&2
}

if (($# < 1)); then
  usage
  exit 1
fi

FLAG_NAME="$1"
ACTION="${2:-toggle}"
FLAG_FILE="$HOME/.local/state/wh01s17/toggles/hypr/$FLAG_NAME.lua"
FLAG_SOURCE="$WH01S17_PATH/default/hypr/toggles/$FLAG_NAME.lua"

on() {
  if [[ -f $FLAG_SOURCE ]]; then
    mkdir -p "$(dirname "$FLAG_FILE")" || return 1
    cp -T "$FLAG_SOURCE" "$FLAG_FILE"
  else
    echo "Flag not found: $FLAG_NAME" >&2
    exit 1
  fi
}

off() {
  rm -f "$FLAG_FILE"
}

toggle() {
  if [[ -f $FLAG_FILE ]]; then
    off || return 1
    echo "off"
  else
    on || return 1
    echo "on"
  fi
}

case $ACTION in
  on) on ;;
  off) off ;;
  toggle) toggle ;;
  *)
    usage
    exit 1
    ;;
esac || exit 1

hyprctl reload >/dev/null
