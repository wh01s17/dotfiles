#!/bin/bash

# wh01s17:summary=Remove Steam and all of its game libraries, configs, and caches.
# wh01s17:requires-sudo=true

set -e

wh01s17-pkg-drop steam

rm -rf \
  "$HOME/.steam" \
  "$HOME/.local/share/Steam" \
  "$HOME/.config/steam" \
  "$HOME/.cache/steam"

echo ""
echo "Steam and its data have been removed."
