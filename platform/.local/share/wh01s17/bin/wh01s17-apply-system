#!/bin/bash

# wh01s17:summary=Apply wh01s17 system setup in the installed target
# wh01s17:group=apply
# wh01s17:requires-sudo=true
# wh01s17:examples=wh01s17 apply system --install-user dhh --first-install
# wh01s17:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: wh01s17 apply system --install-user USER [--first-install|--upgrade]
       wh01s17 apply system --defer-provisioning --first-install

Runs root-owned wh01s17 system setup. The ISO calls this in the target chroot
after packages are installed and the target user exists. It also calls
wh01s17-apply-hardware, so hardware setup cannot be accidentally skipped.

--defer-provisioning runs without an install user: deferred-provisioning installs create the user at
first boot, so scripts that grant group memberships record them in
/var/lib/wh01s17/provisioning/groups instead of calling usermod.
USAGE
}

install_user="${WH01S17_INSTALL_USER:-}"
first_install=0
upgrade=0
defer_provisioning=0

while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    --first-install)
      first_install=1
      shift
      ;;
    --upgrade)
      upgrade=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: wh01s17-apply-system must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export WH01S17_INSTALL_USER="$install_user"
export WH01S17_FIRST_INSTALL="$first_install"
export WH01S17_UPGRADE="$upgrade"
export WH01S17_PATH="${WH01S17_PATH:-$HOME/.local/share/wh01s17}"
export WH01S17_INSTALL="${WH01S17_INSTALL:-$WH01S17_PATH/install}"
export WH01S17_INSTALL_LOG_FILE="${WH01S17_INSTALL_LOG_FILE:-/var/log/wh01s17-install.log}"
export PATH="$WH01S17_PATH/bin:$PATH"

source "$WH01S17_INSTALL/helpers/logging.sh"
start_install_log

source "$WH01S17_INSTALL/config/all.sh"

if (( defer_provisioning )); then
  wh01s17-apply-hardware --defer-provisioning
else
  wh01s17-apply-hardware --install-user "$install_user"
fi

source "$WH01S17_INSTALL/login/all.sh"
source "$WH01S17_INSTALL/post-install/all.sh"

stop_install_log
