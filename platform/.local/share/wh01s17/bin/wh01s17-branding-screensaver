#!/bin/bash

# wh01s17:summary=Edit, set, or reset screensaver branding
# wh01s17:group=branding
# wh01s17:name=screensaver
# wh01s17:args=<image|text|reset>
# wh01s17:examples=wh01s17 branding screensaver image | wh01s17 branding screensaver text | wh01s17 branding screensaver reset

set -euo pipefail

case "${1:-}" in
image)
  image=$(wh01s17-file-select --title "Pick PNG or SVG for screensaver" --extensions "png svg")
  if wh01s17-transcode-ascii "$image" ~/.config/wh01s17/branding/screensaver.txt; then
    wh01s17-launch-screensaver force >/dev/null 2>&1
  fi
  ;;
text)
  wh01s17-launch-editor ~/.config/wh01s17/branding/screensaver.txt >/dev/null 2>&1 && wh01s17-launch-screensaver force >/dev/null 2>&1
  ;;
reset)
  cp "$WH01S17_PATH/logo.txt" ~/.config/wh01s17/branding/screensaver.txt && wh01s17-launch-screensaver force >/dev/null 2>&1
  ;;
*)
  echo "Usage: wh01s17-branding-screensaver <image|text|reset>" >&2
  exit 1
  ;;
esac
