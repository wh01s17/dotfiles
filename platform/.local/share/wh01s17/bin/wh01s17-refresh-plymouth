#!/bin/bash

# wh01s17:summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the wh01s17 default and rebuild it.
# wh01s17:requires-sudo=true

# Reuse the fixed-file publisher so root never resolves the source checkout or
# follows a destination symlink while restoring the packaged assets.
exec "$WH01S17_PATH/bin/wh01s17-plymouth-set" --refresh-default
