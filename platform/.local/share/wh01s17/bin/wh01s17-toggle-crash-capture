#!/bin/bash

# wh01s17:summary=Toggle crash capture notifications

# nf-md-robot_dead, escaped so this file reads without a Nerd Font.
readonly CRASH_GLYPH=$'\U000f16a1'

wh01s17-toggle crash-capture-off

# The unit checks the same flag with ConditionPathExists, so stopping and
# starting only settles this session; the next login reads the flag itself.
if wh01s17-toggle-enabled crash-capture-off; then
  systemctl --user stop wh01s17-crash-watch.service
  wh01s17-notification-send -g "$CRASH_GLYPH" "Crash capture disabled"
else
  systemctl --user start wh01s17-crash-watch.service
  wh01s17-notification-send -g "$CRASH_GLYPH" "Crash capture enabled"
fi
