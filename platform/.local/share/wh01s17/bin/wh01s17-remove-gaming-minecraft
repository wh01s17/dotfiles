#!/bin/bash

# wh01s17:summary=Remove the Minecraft launcher along with its worlds, mods, and caches.
# wh01s17:requires-sudo=true

set -e

wh01s17-pkg-drop minecraft-launcher

rm -rf \
  "$HOME/.minecraft" \
  "$HOME/.config/Minecraft Launcher" \
  "$HOME/.local/share/minecraft-launcher" \
  "$HOME/.cache/minecraft"

echo ""
echo "Minecraft and its data have been removed."
