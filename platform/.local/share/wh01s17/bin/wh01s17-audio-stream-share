#!/bin/bash

# wh01s17:summary=Send an app's playback to the Compartido sink, or back
# wh01s17:group=audio
# wh01s17:args=list | on <node-id> | off <node-id>
# wh01s17:examples=wh01s17 audio stream share on 155

# "Compartido" (~/.config/pipewire/pipewire.conf.d/20-mezcla.conf) plays on the
# selected output and also feeds the Mezcla virtual microphone. Moving an app's
# stream there sends that app along with the mic; WirePlumber remembers the
# choice per application, so its later streams go there too.
#
# Takes PipeWire node ids (what the shell sees); pactl numbers sink inputs
# differently, so they are matched through each sink input's object.id.
# `list` prints the node ids of the streams currently on Compartido.

SHARED=Compartido

sink_index() {
  LC_ALL=C pactl list short sinks 2>/dev/null | awk -v name="$1" '$2 == name {print $1}'
}

# Prints "<pactl-index> <node-id> <sink-index>" per sink input.
sink_inputs() {
  LC_ALL=C pactl list sink-inputs 2>/dev/null | awk '
    /^Sink Input #/ { if (idx != "") print idx, obj, sink; idx = substr($3, 2); obj = ""; sink = "" }
    /^\tSink: / { sink = $2 }
    /object\.id = / { v = $0; sub(/.*object\.id = "/, "", v); sub(/".*/, "", v); obj = v }
    END { if (idx != "") print idx, obj, sink }'
}

pactl_index_for() {
  sink_inputs | awk -v node="$1" '$2 == node {print $1; exit}'
}

case ${1:-list} in
  list)
    shared=$(sink_index "$SHARED")
    [[ -n $shared ]] || exit 0
    sink_inputs | awk -v shared="$shared" '$3 == shared {print $2}'
    ;;
  on|off)
    node=${2:-}
    [[ -n $node ]] || { echo "Usage: wh01s17-audio-stream-share $1 <node-id>" >&2; exit 1; }
    index=$(pactl_index_for "$node")
    [[ -n $index ]] || { echo "no playback stream for node $node" >&2; exit 1; }
    if [[ $1 == on ]]; then
      [[ -n $(sink_index "$SHARED") ]] || { echo "sink $SHARED not found" >&2; exit 1; }
      target=$SHARED
    else
      target=$(pactl get-default-sink 2>/dev/null)
    fi
    pactl move-sink-input "$index" "$target"
    ;;
  *)
    echo "Usage: wh01s17-audio-stream-share list | on <node-id> | off <node-id>" >&2
    exit 1
    ;;
esac
