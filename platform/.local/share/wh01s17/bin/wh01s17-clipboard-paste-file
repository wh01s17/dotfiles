#!/bin/bash

# wh01s17:summary=Copy a file to the clipboard and paste it
# wh01s17:group=clipboard
# wh01s17:args=[--copy-only] <mime-type> <path>
# wh01s17:examples=wh01s17 clipboard paste file image/png /tmp/screenshot.png
# wh01s17:hidden=true

copy_only=false

if [[ ${1:-} == "--copy-only" ]]; then
  copy_only=true
  shift
fi

mime=${1:-}
path=${2:-}

if [[ -z $mime || -z $path ]]; then
  echo "Usage: wh01s17-clipboard-paste-file [--copy-only] <mime-type> <path>" >&2
  exit 1
fi

[[ -r $path ]] || exit 1

wl-copy --type "$mime" < "$path"

if [[ $copy_only == "true" ]]; then
  exit
fi

sleep 0.15
wtype -M shift -k Insert -m shift 2>/dev/null || true
