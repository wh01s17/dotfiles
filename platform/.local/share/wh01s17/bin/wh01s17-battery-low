#!/bin/bash

# wh01s17:summary=Send the low battery warning notification and run battery-low hooks.
# wh01s17:args=<percentage>
# wh01s17:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: wh01s17-battery-low <percentage>" >&2
  exit 1
fi

level=$1

wh01s17-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
wh01s17-hook battery-low "$level"
