#!/bin/bash

# wh01s17:summary=Open the Plymouth unlock screen switcher

preview_dir="${XDG_CACHE_HOME:-$HOME/.cache}/wh01s17/unlock-selector/previews"

rm -rf "$preview_dir"
mkdir -p "$preview_dir"

ln -s "$WH01S17_PATH/default/plymouth/preview-unlock.png" "$preview_dir/default.png"

wh01s17-plymouth-list | while read -r name; do
  ln -s "$(wh01s17-theme-dir "$name")/preview-unlock.png" "$preview_dir/$name.png" 2>/dev/null
done

current=$(wh01s17-plymouth-current)
selected=""
[[ -n $current && -e $preview_dir/$current.png ]] && selected="$preview_dir/$current.png"

exec wh01s17-menu-images --print-name --show-labels --selected "$selected" "$preview_dir"
