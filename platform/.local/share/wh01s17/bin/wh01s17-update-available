#!/bin/bash

# wh01s17:summary=Report available system updates
# wh01s17:hidden=true
#
# Replaced for plain Arch: the original managed a remote package
# repository, uploaded data or treated the runtime path (here ~/dotfiles)
# as a git checkout.

count=$(checkupdates --nocolor 2>/dev/null | wc -l)
if command -v yay >/dev/null 2>&1; then
  count=$((count + $(yay -Qua 2>/dev/null | wc -l)))
fi
if ((count > 0)); then
  echo "$count actualizaciones de paquetes disponibles"
  exit 0
fi
echo "El sistema está al día"
exit 1
