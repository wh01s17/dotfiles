#!/bin/bash

# wh01s17:summary=Launch or focus on a given web app identified by the window-pattern.
# wh01s17:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: wh01s17-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="wh01s17-launch-webapp $@"

exec wh01s17-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
