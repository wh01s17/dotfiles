#!/bin/bash

# wh01s17:summary=Pick a webcam and start a screen recording with it
# wh01s17:examples=wh01s17 capture screenrecording-with-webcam

mapfile -t devices < <(wh01s17-capture-webcam-list)
if (( ${#devices[@]} == 0 )); then
  wh01s17-notification-send "No webcam devices found" -u critical -t 3000
  exit 1
fi

if (( ${#devices[@]} == 1 )); then
  device="${devices[0]%%[[:space:]]*}"
else
  selection=$(wh01s17-menu-select "Select Webcam" "${devices[@]}" -- --width 520 --maxheight 520) || exit 1
  device="${selection%%[[:space:]]*}"
fi

exec wh01s17-capture-screenrecording \
  --with-desktop-audio --with-microphone-audio \
  --with-webcam --webcam-device="$device"
