#!/bin/bash

set -e

# wh01s17 ships no default agent, so invite once rather than picking one. An
# agent already chosen means the invitation has nothing to offer.
if [[ -z $(wh01s17-default-agent) ]] && wh01s17-done ensure agent-setup-invitation; then
  wh01s17-notification-send -u critical -g 󰚩 "Set your default agent" \
    "Let your favorite agent help with wh01s17." \
    --exec wh01s17 menu summon setup.default.agent
fi
