[Unit]
Description=Borra copias sobrantes de actualizaciones de plugins de Codex
# Sin Codex instalado (o aún sin usar) la carpeta no existe y find fallaría.
ConditionPathIsDirectory=%h/.codex/.tmp/marketplaces/.staging

[Service]
Type=oneshot
ExecStart=/usr/bin/find %h/.codex/.tmp/marketplaces/.staging -mindepth 1 -maxdepth 1 -mtime +1 -exec rm -rf {} +
